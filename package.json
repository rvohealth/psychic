{
  "type": "module",
  "name": "@rvoh/psychic",
  "description": "Typescript web framework",
  "version": "3.18.2",
  "author": "RVOHealth",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rvohealth/psychic.git"
  },
  "license": "MIT",
  "main": "./dist/cjs/src/package-exports/index.js",
  "module": "./dist/esm/src/package-exports/index.js",
  "types": "./dist/types/src/package-exports/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/package-exports/index.d.ts",
      "import": "./dist/esm/src/package-exports/index.js",
      "require": "./dist/cjs/src/package-exports/index.js"
    },
    "./errors": {
      "types": "./dist/types/src/package-exports/errors.d.ts",
      "import": "./dist/esm/src/package-exports/errors.js",
      "require": "./dist/cjs/src/package-exports/errors.js"
    },
    "./system": {
      "types": "./dist/types/src/package-exports/system.d.ts",
      "import": "./dist/esm/src/package-exports/system.js",
      "require": "./dist/cjs/src/package-exports/system.js"
    },
    "./openapi": {
      "types": "./dist/types/src/package-exports/openapi.d.ts",
      "import": "./dist/esm/src/package-exports/openapi.js",
      "require": "./dist/cjs/src/package-exports/openapi.js"
    },
    "./types": {
      "types": "./dist/types/src/package-exports/types.d.ts",
      "import": "./dist/esm/src/package-exports/types.js",
      "require": "./dist/cjs/src/package-exports/types.js"
    },
    "./utils": {
      "types": "./dist/types/src/package-exports/utils.d.ts",
      "import": "./dist/esm/src/package-exports/utils.js",
      "require": "./dist/cjs/src/package-exports/utils.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "client": "cd client && pnpm start",
    "client:fspec": "cd client && VITE_PSYCHIC_ENV=test BROWSER=none pnpm start",
    "psy": "NODE_ENV=${NODE_ENV:-test} pnpm psyts",
    "psyjs": "node ./dist/test-app/src/cli/index.js",
    "psyts": "NODE_ENV=${NODE_ENV:-test} tsx ./test-app/src/cli/index.ts",
    "gpsy": "tsx ./global-cli/main.ts",
    "build": "echo \"building cjs...\" && rm -rf dist && tsc -p ./tsconfig.cjs.build.json && echo \"building esm...\" && tsc -p ./tsconfig.esm.build.json",
    "build:test-app": "rm -rf dist && echo \"building test app to esm...\" && tsc -p ./tsconfig.esm.build.test-app.json && echo \"building test app to cjs...\" && tsc -p ./tsconfig.cjs.build.test-app.json",
    "types:esm:trace": "rm -rf dist && tsc -p ./tsconfig.esm.build.json --generateTrace ./typetrace --diagnostics && pnpm analyze-trace ./typetrace --skipMillis 100 --forceMillis 300",
    "dev": "tsx ./test-app/main.ts",
    "console": "tsx ./test-app/src/conf/repl.ts",
    "uspec": "vitest --config ./spec/unit/vite.config.ts",
    "fspec": "vitest run --config=./spec/features/vite.config.ts",
    "format": "pnpm prettier . --write",
    "lint": "pnpm eslint --no-warn-ignored \"src/**/*.ts\" \"spec/**/*.ts\" \"test-app/**/*.ts\" && pnpm prettier . --check",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "ajv": "^8.19.0",
    "ajv-formats": "^3.0.1",
    "fast-json-stringify": "^6.4.0",
    "yoctocolors": "^2.1.1"
  },
  "peerDependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@koa/cors": "^5.0.0",
    "@koa/etag": "^5.0.2",
    "@koa/router": "^15.3.0",
    "@rvoh/dream": "^2.40.0",
    "@types/koa": "^3.0.1",
    "@types/koa-conditional-get": "^2.0.3",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.5",
    "commander": "^14.0.3",
    "dotenv": "*",
    "koa": "^3.1.2",
    "koa-conditional-get": "^3.0.0",
    "openapi-typescript": "^7.8.0",
    "pluralize-esm": "^9.0.5",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@types/koa": {
      "optional": true
    },
    "@types/koa-conditional-get": {
      "optional": true
    },
    "@types/koa__cors": {
      "optional": true
    },
    "@types/koa__router": {
      "optional": true
    },
    "openapi-typescript": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@koa/bodyparser": "^6.1.0",
    "@koa/cors": "^5.0.0",
    "@koa/etag": "^5.0.2",
    "@koa/router": "^15.3.1",
    "@rvoh/dream": "^2.41.0",
    "@rvoh/dream-spec-helpers": "^2.4.0",
    "@rvoh/psychic-spec-helpers": "3.5.0",
    "@types/koa": "^3.0.1",
    "@types/koa-conditional-get": "^2.0.3",
    "@types/koa-passport": "^6.0.3",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^26.6.3",
    "@types/passport": "^0",
    "@types/passport-local": "^1",
    "@types/pg": "^8.11.8",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/parser": "^8.57.1",
    "@typescript/analyze-trace": "^0.10.1",
    "commander": "^14.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^10.0.0",
    "jsdom": "^26.1.0",
    "koa": "^3.1.2",
    "koa-conditional-get": "^3.0.0",
    "koa-passport": "^6.0.0",
    "koa-session": "^7.0.2",
    "kysely": "^0.29.0",
    "luxon-jest-matchers": "^0.1.14",
    "openapi-typescript": "^7.13.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.12.0",
    "pluralize-esm": "^9.0.5",
    "prettier": "^3.3.3",
    "puppeteer": "^25.8.0",
    "supertest": "^7.3.0",
    "tslib": "^2.7.0",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0",
    "winston": "^3.14.2"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
